__pycache__/
*.pyc
.venv/
# 平台自带的 Node 运行时（Node 子项目用；见 scripts/setup-node.sh）
.node/
logs/
# 网关运行期数据（访问统计计数等），随部署环境走，不入库
data/
*.pid
*.log
.DS_Store

# 子项目内容默认不入库（各项目独立管理，且可能包含数据/隐私），仅保留目录占位
container/*
!container/.gitkeep
# 例外：置顶清单是平台配置而非项目内容，随仓库一起管理
!container/pinned.json

# 例外：StockMonitoring 为本仓库原生项目，入库其源代码；运行期数据仍排除
!container/StockMonitoring/
container/StockMonitoring/data/
